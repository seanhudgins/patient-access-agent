#!/bin/sh
# Blocks commits that contain secrets. Turn on once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks not installed: commit blocked. Install it (brew install gitleaks) or commit with --no-verify at your own risk." >&2
    exit 1
fi
gitleaks git --pre-commit --staged --no-banner || exit 1

# Private repo only (publish/ is never copied out): block the commit if the public copy would
# contain a denied term (the DENY list in publish/publish.py).
if [ -f publish/publish.py ]; then
    python3 -I publish/publish.py --check || exit 1
fi
